# Application Settings
APP_NAME=TruthLens AI
APP_ENV=development
DEBUG=True
PORT=8000
HOST=0.0.0.0

# CORS (JSON Array of allowed origins)
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# Storage & Upload Limits
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=100
MAX_FRAMES_TO_EXTRACT=20
FRAME_SAMPLE_INTERVAL_SEC=0.5

# Model Settings
MODEL_NAME=TruthLens Pretrained ResNet/EfficientNet Detector v1.0
MODEL_WEIGHTS_PATH=app/models/weights/model_weights.pt
DEVICE=cpu

# Optional MongoDB Database Settings (disabled if unset or empty)
MONGODB_URI=
MONGODB_DB_NAME=truthlens
ENABLE_DB=false
