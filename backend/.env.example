# Application Settings
APP_NAME=TruthLens AI
APP_ENV=development
DEBUG=True
PORT=8000
HOST=0.0.0.0

# CORS (JSON Array of allowed origins)
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# Storage & Upload Limits
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=100
MAX_FRAMES_TO_EXTRACT=12
MAX_VIDEO_DURATION_SEC=300
FRAME_SAMPLE_INTERVAL_SEC=0.5
FACE_PADDING_PERCENT=0.20

# Video Model Settings
MODEL_NAME=Vision Transformer (ViT) Deepfake Detector
MODEL_ID=dima806/deepfake_vs_real_image_detection
MODEL_WEIGHTS_PATH=
DEVICE=cpu
HIGH_RISK_THRESHOLD=0.65
LOW_RISK_THRESHOLD=0.40

# Audio Model Settings
ENABLE_AUDIO_DETECTION=true
AUDIO_MODEL_NAME=Wav2Vec2 Speech Anti-Spoofing Detector
AUDIO_MODEL_ID=Vansh180/deepfake-audio-wav2vec2
AUDIO_SAMPLE_RATE=16000
AUDIO_SEGMENT_DURATION_SEC=5.0
AUDIO_MAX_DURATION_SEC=60.0
AUDIO_HIGH_RISK_THRESHOLD=0.65
AUDIO_LOW_RISK_THRESHOLD=0.40

# Optional MongoDB Database Settings (disabled if unset or empty)
MONGODB_URI=
MONGODB_DB_NAME=truthlens
ENABLE_DB=false
